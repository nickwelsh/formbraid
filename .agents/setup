#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
TIMEFORMAT='[setup] Step completed in %3R seconds'
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

echo '[setup] Preparing system packages and toolchains'
time {
    missing=()
    for package in ca-certificates curl unzip xz-utils; do
        if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
            missing+=("$package")
        fi
    done
    if ((${#missing[@]})); then
        sudo apt-get update
        sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
    fi

    # Use the CI major rather than an orb image's newer, untested Node release.
    if ! command -v node >/dev/null || ! node -e '
        const [major, minor] = process.versions.node.split(".").map(Number);
        process.exit(major === 24 && minor >= 11 ? 0 : 1);
    '; then
        node_version=24.22.2
        case "$(uname -m)" in
            x86_64) node_arch=x64 ;;
            aarch64) node_arch=arm64 ;;
            *) echo 'Unsupported Node architecture' >&2; exit 1 ;;
        esac
        archive="node-v${node_version}-linux-${node_arch}.tar.xz"
        curl -fsSL "https://nodejs.org/dist/v${node_version}/SHASUMS256.txt" -o "$scratch/SHASUMS256.txt"
        curl -fsSL "https://nodejs.org/dist/v${node_version}/$archive" -o "$scratch/$archive"
        (cd "$scratch" && grep "  $archive$" SHASUMS256.txt | sha256sum -c -)
        sudo tar -xJf "$scratch/$archive" -C /usr/local --strip-components=1
    fi

    pnpm_version="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
    if ! command -v pnpm >/dev/null || [[ "$(pnpm --version)" != "$pnpm_version" ]]; then
        sudo npm install --global --force "pnpm@$pnpm_version"
    fi

    # Debian 12 ships PHP 8.2; the locked dev dependencies require PHP 8.4.1+.
    missing=()
    for package in php8.4-cli php8.4-curl php8.4-mbstring php8.4-xml php8.4-sqlite3 php8.4-zip; do
        if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
            missing+=("$package")
        fi
    done
    if ((${#missing[@]})); then
        if [[ ! -f /usr/share/keyrings/debsuryorg-archive-keyring.gpg ]]; then
            curl -fsSL https://packages.sury.org/debsuryorg-archive-keyring.deb -o "$scratch/php-keyring.deb"
            sudo env DEBIAN_FRONTEND=noninteractive dpkg -i "$scratch/php-keyring.deb"
        fi
        . /etc/os-release
        printf 'deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ %s main\n' \
            "$VERSION_CODENAME" | sudo tee /etc/apt/sources.list.d/php.list >/dev/null
        sudo apt-get update
        sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
    fi
    if ! command -v php >/dev/null || ! php -r 'exit(PHP_MAJOR_VERSION === 8 && PHP_MINOR_VERSION === 4 ? 0 : 1);'; then
        sudo update-alternatives --set php /usr/bin/php8.4
    fi

    if ! command -v composer >/dev/null; then
        curl -fsSL https://composer.github.io/installer.sig -o "$scratch/composer.sig"
        curl -fsSL https://getcomposer.org/installer -o "$scratch/composer-setup.php"
        printf '%s  %s\n' "$(cat "$scratch/composer.sig")" "$scratch/composer-setup.php" | sha384sum -c -
        php "$scratch/composer-setup.php" --2 --install-dir="$scratch" --filename=composer
        sudo install -m 0755 "$scratch/composer" /usr/local/bin/composer
    fi
    node --version
    pnpm --version
    php --version
    composer --version
}

echo '[setup] Installing workspace dependencies from pnpm-lock.yaml'
time pnpm install --frozen-lockfile

echo '[setup] Installing Laravel development dependencies from composer.lock'
time composer install --working-dir=packages/laravel --no-interaction --prefer-dist --no-progress

echo '[setup] Building library exports and linking the workspace CLI (not the docs site)'
time pnpm exec vp run --filter './packages/*' --cache build
# pnpm cannot link the formbraid bin until the generator has been built.
time pnpm install --frozen-lockfile --offline

echo "[setup] Ready in ${SECONDS}s; no servers or authentication are needed during setup"
