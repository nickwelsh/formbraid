{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "types": ["node", "vite-plus/client", "vite-plus/test/globals"],
        "paths": {
            "@formbraid/core": ["./packages/core/src/index.ts"],
            "@formbraid/core/vite": ["./packages/core/src/vite.ts"],
            "@formbraid/react": ["./packages/react/src/index.ts"],
            "@formbraid/generator": ["./packages/generator/src/index.ts"],
            "@formbraid/example/*": ["./examples/react/src/*"]
        }
    },
    "include": [
        "./packages/**/*.ts",
        "./packages/**/*.tsx",
        "examples/**/*.ts",
        "examples/**/*.tsx",
        "vite.config.ts",
        "benchmarks/**/*.ts",
        "scripts/**/*.ts"
    ],
    "exclude": ["**/dist", "**/node_modules"]
}
